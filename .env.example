# PULSEIQ React + FastAPI + Supabase PostgreSQL
# Copy these secrets into Render -> Service -> Environment. Do not commit real values.
# Use Supabase Dashboard -> Connect -> Session pooler -> URI (not the Project URL).
# Supabase Session pooler format (username must include the project reference):
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_6_PLUS_CHAR_PASSWORD
BOOTSTRAP_COLLEGE_NAME=Demo Engineering College
BOOTSTRAP_COLLEGE_DOMAIN=demo.edu.in
BOOTSTRAP_ADMIN_EMAIL=admin@demo.edu.in
COOKIE_SECURE=true
SEED_DEMO=false
IMPORT_LEGACY_V2=false

# Self-service college registration is public; there is no invite code.
